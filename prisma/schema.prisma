generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String          @id @default(uuid()) @db.Uuid
  googleId             String?         @unique
  profilePhoto         String?
  email                String          @unique @db.VarChar(255)
  passwordHash         String?
  fullName             String?         @db.VarChar(255)
  phone                String?         @db.VarChar(20)
  verificationStatus   String          @default("pendiente") @db.VarChar(20)
  refreshToken         String?
  createdAt            DateTime        @default(now()) @db.Timestamp(0)
  updatedAt            DateTime        @updatedAt @db.Timestamp(0)
  resetPasswordExpires DateTime?       @db.Timestamp(0)
  resetPasswordToken   String?
  role                 UserRole
  device_tokens        device_tokens[]
  favorites            Favorite[]
  interests            Interest[]
  receivedMessages     Message[]       @relation("ReceivedMessages")
  sentMessages         Message[]       @relation("SentMessages")
  notifications        Notification[]
  ownedProperties      Property[]
  reports              Report[]
  reviews              Review[]
  savedSearches        SavedSearch[]
  userPreference       UserPreference? @relation("UserPreferences")

  @@map("users")
}

model Property {
  id              String          @id @default(uuid()) @db.Uuid
  ownerId         String          @db.Uuid
  title           String          @db.VarChar(255)
  description     String?
  address         String?         @db.VarChar(500)
  city            String          @default("Cochabamba") @db.VarChar(100)
  areaM2          Decimal?        @db.Decimal(10, 2)
  price           Decimal         @db.Decimal(12, 2)
  status          String          @default("disponible") @db.VarChar(20)
  createdAt       DateTime        @default(now()) @db.Timestamp(0)
  updatedAt       DateTime        @updatedAt @db.Timestamp(0)
  latitude        Decimal?        @db.Decimal(10, 8)
  longitude       Decimal?        @db.Decimal(11, 8)
  operationTypeId String?         @db.Uuid
  propertyTypeId  String?         @db.Uuid
  provinceId      String?         @db.Uuid
  paymentId       String?         @db.Uuid
  favorites       Favorite[]
  interests       Interest[]
  operationType   OperationType?  @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  propertyType    PropertyType?   @relation(fields: [propertyTypeId], references: [id], onDelete: Cascade)
  province        Province?       @relation(fields: [provinceId], references: [id])
  propertyPhotos  PropertyPhoto[]
  reports         Report[]
  reviews         Review[]

  @@index([city])
  @@index([status])
  @@index([price])
  @@index([ownerId])
  @@map("properties")
}

model OperationType {
  id                              String                            @id @default(uuid()) @db.Uuid
  name                            String                            @unique @db.VarChar(20)
  properties                      Property[]
  user_preference_operation_types user_preference_operation_types[]
  user_preferences                UserPreference[]

  @@map("operation_types")
}

model PropertyType {
  id                             String                           @id @default(uuid()) @db.Uuid
  name                           String                           @unique @db.VarChar(50)
  properties                     Property[]
  user_preference_property_types user_preference_property_types[]

  @@map("property_types")
}

model Payment {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique @db.VarChar(50)
  days       Int
  properties Property[]

  @@map("payment_types")
}

model Province {
  id                        String                      @id @default(uuid()) @db.Uuid
  name                      String                      @unique @db.VarChar(100)
  properties                Property[]
  user_preference_provinces user_preference_provinces[]

  @@map("provinces")
}

model Interest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  propertyId String    @db.Uuid
  message    String?
  status     String    @default("pendiente") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([userId])
  @@index([propertyId])
  @@map("interests")
}

model Message {
  id         BigInt    @id @default(autoincrement())
  senderId   String    @db.Uuid
  receiverId String    @db.Uuid
  interestId String?   @db.Uuid
  content    String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  interest   Interest? @relation(fields: [interestId], references: [id])
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([interestId])
  @@map("messages")
}

model PropertyPhoto {
  id         BigInt   @id @default(autoincrement())
  propertyId String   @db.Uuid
  url        String
  order      Int?
  createdAt  DateTime @default(now()) @db.Timestamp(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model Review {
  id         BigInt   @id @default(autoincrement())
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  content    String
  rating     Int
  createdAt  DateTime @default(now()) @db.Timestamp(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  content   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(0)
  deleted   Boolean  @default(false)
  pushSent  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([deleted])
  @@map("notifications")
}

model Report {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  finishDate DateTime? @db.Timestamp(0)
  propertyId String    @db.Uuid
  startDate  DateTime? @db.Timestamp(0)
  status     String    @db.VarChar(30)
  totalPrice Decimal?  @db.Decimal(10, 2)
  uploadedAt DateTime? @db.Timestamp(0)
  updatedAt  DateTime? @db.Timestamp(0)
  properties Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@map("reports")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamp(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

model SavedSearch {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  searchParameters Json
  searchName       String?  @db.VarChar(255)
  createdAt        DateTime @default(now()) @db.Timestamp(0)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

model UserPreference {
  id                              String                            @id @default(uuid()) @db.Uuid
  userId                          String                            @unique @db.Uuid
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  operationTypeId                 String?                           @db.Uuid
  user_preference_operation_types user_preference_operation_types[]
  user_preference_property_types  user_preference_property_types[]
  user_preference_provinces       user_preference_provinces[]
  operation_types                 OperationType?                    @relation(fields: [operationTypeId], references: [id])
  user                            User                              @relation("UserPreferences", fields: [userId], references: [id])

  @@map("user_preferences")
}

model device_tokens {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  token     String   @db.VarChar(500)
  platform  String   @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @db.Timestamp(0)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model user_preference_operation_types {
  id               String         @id @db.Uuid
  userPreferenceId String         @db.Uuid
  operationTypeId  String         @db.Uuid
  operation_types  OperationType  @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)
  user_preferences UserPreference @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)

  @@unique([userPreferenceId, operationTypeId])
}

model user_preference_property_types {
  id               String         @id @db.Uuid
  userPreferenceId String         @db.Uuid
  propertyTypeId   String         @db.Uuid
  property_types   PropertyType   @relation(fields: [propertyTypeId], references: [id], onDelete: Cascade)
  user_preferences UserPreference @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)

  @@unique([userPreferenceId, propertyTypeId])
}

model user_preference_provinces {
  id               String         @id @db.Uuid
  userPreferenceId String         @db.Uuid
  provinceId       String         @db.Uuid
  provinces        Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  user_preferences UserPreference @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)

  @@unique([userPreferenceId, provinceId])
}

enum UserRole {
  rentante
  arrendador
}
