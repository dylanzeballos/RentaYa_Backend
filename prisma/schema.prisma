generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  rentante
  arrendador
}

model User {
  id                   String          @id @default(uuid()) @db.Uuid
  googleId             String?         @unique
  profilePhoto         String?
  email                String          @unique @db.VarChar(255)
  passwordHash         String?
  fullName             String?         @db.VarChar(255)
  phone                String?         @db.VarChar(20)
  role                 UserRole
  verificationStatus   String          @default("pendiente") @db.VarChar(20)
  refreshToken         String?
  createdAt            DateTime        @default(now()) @db.Timestamp(0)
  updatedAt            DateTime        @updatedAt @db.Timestamp(0)
  resetPasswordExpires DateTime?       @db.Timestamp(0)
  resetPasswordToken   String?
  deviceTokens         DeviceToken[]
  favorites            Favorite[]
  interests            Interest[]
  receivedMessages     Message[]       @relation("ReceivedMessages")
  sentMessages         Message[]       @relation("SentMessages")
  notifications        Notification[]
  ownedProperties      Property[]
  reports              Report[]
  reviews              Review[]
  savedSearches        SavedSearch[]
  userPreference       UserPreference? @relation("UserPreferences")

  @@map("users")
}

model Property {
  id              String          @id @default(uuid()) @db.Uuid
  ownerId         String          @db.Uuid
  title           String          @db.VarChar(255)
  description     String?
  address         String?         @db.VarChar(500)
  city            String          @default("Cochabamba") @db.VarChar(100)
  provinceId      String?         @db.Uuid
  areaM2          Decimal?        @db.Decimal(10, 2)
  price           Decimal         @db.Decimal(12, 2)
  paymentId       String?         @db.Uuid
  operationTypeId String?         @db.Uuid
  propertyTypeId  String?         @db.Uuid
  status          String          @default("disponible") @db.VarChar(20)
  createdAt       DateTime        @default(now()) @db.Timestamp(0)
  updatedAt       DateTime        @updatedAt @db.Timestamp(0)
  latitude        Decimal?        @db.Decimal(10, 8)
  longitude       Decimal?        @db.Decimal(11, 8)
  favorites       Favorite[]
  interests       Interest[]
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  operationType   OperationType?  @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)
  propertyType    PropertyType?   @relation(fields: [propertyTypeId], references: [id], onDelete: Cascade)
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  province        Province?       @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  propertyPhotos  PropertyPhoto[]
  reports         Report[]
  reviews         Review[]

  @@index([city])
  @@index([status])
  @@index([price])
  @@index([ownerId])
  @@map("properties")
}

model OperationType {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String                        @unique @db.VarChar(20)
  properties                   Property[]
  userPreferences              UserPreference[]
  userPreferenceOperationTypes UserPreferenceOperationType[]

  @@map("operation_types")
}

model PropertyType {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String                       @unique @db.VarChar(50)
  properties                  Property[]
  userPreferencePropertyTypes UserPreferencePropertyType[]

  @@map("property_types")
}

model Payment {
  id                          String                       @id @default(uuid()) @db.Uuid
  name                        String                       @unique @db.VarChar(50)
  days                        Int

  properties  Property[] 

  @@map("payment_types")
}

model Province {
  id                       String                   @id @default(uuid()) @db.Uuid
  name                     String                   @unique @db.VarChar(100)
  properties               Property[]
  userPreferencesProvinces UserPreferenceProvince[]

  @@map("provinces")
}

model Interest {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  propertyId String    @db.Uuid
  message    String?
  status     String    @default("pendiente") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([userId])
  @@index([propertyId])
  @@map("interests")
}

model Message {
  id         BigInt    @id @default(autoincrement())
  senderId   String    @db.Uuid
  receiverId String    @db.Uuid
  interestId String?   @db.Uuid
  content    String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  interest   Interest? @relation(fields: [interestId], references: [id])
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([interestId])
  @@map("messages")
}

model PropertyPhoto {
  id         BigInt   @id @default(autoincrement())
  propertyId String   @db.Uuid
  url        String
  order      Int?
  createdAt  DateTime @default(now()) @db.Timestamp(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_photos")
}

model Review {
  id         BigInt   @id @default(autoincrement())
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  content    String
  rating     Int
  createdAt  DateTime @default(now()) @db.Timestamp(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  content   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @db.Timestamp(0)
  deleted   Boolean  @default(false)
  pushSent  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([deleted])
  @@map("notifications")
}

model Report {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  propertyId String    @db.Uuid
  totalPrice Decimal?  @db.Decimal(10, 2)
  status     String    @db.VarChar(30)
  startDate  DateTime? @db.Timestamp(0)
  finishDate DateTime? @db.Timestamp(0)

  createdAt  DateTime  @default(now()) @db.Timestamp(0)
  updatedAt  DateTime? @db.Timestamp(0)

  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@map("reports")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  propertyId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamp(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

model SavedSearch {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  searchParameters Json
  searchName       String?  @db.VarChar(255)
  createdAt        DateTime @default(now()) @db.Timestamp(0)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

model UserPreference {
  id                          String                        @id @default(uuid()) @db.Uuid
  userId                      String                        @unique @db.Uuid
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  user                        User                          @relation("UserPreferences", fields: [userId], references: [id])
  operationTypes              UserPreferenceOperationType[]
  userPreferenceProvinces     UserPreferenceProvince[]
  userPreferencePropertyTypes UserPreferencePropertyType[]
  OperationType               OperationType?                @relation(fields: [operationTypeId], references: [id])
  operationTypeId             String?                       @db.Uuid

  @@map("user_preferences")
}

model UserPreferenceProvince {
  id               String         @id @default(uuid()) @db.Uuid
  userPreferenceId String         @db.Uuid
  provinceId       String         @db.Uuid
  userPreference   UserPreference @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)
  province         Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@unique([userPreferenceId, provinceId])
  @@map("user_preference_provinces")
}

model UserPreferencePropertyType {
  id               String         @id @default(uuid()) @db.Uuid
  userPreferenceId String         @db.Uuid
  propertyTypeId   String         @db.Uuid
  userPreference   UserPreference @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)
  propertyType     PropertyType   @relation(fields: [propertyTypeId], references: [id], onDelete: Cascade)

  @@unique([userPreferenceId, propertyTypeId])
  @@map("user_preference_property_types")
}

model UserPreferenceOperationType {
  id               String         @id @default(uuid()) @db.Uuid
  userPreferenceId String         @db.Uuid
  operationTypeId  String         @db.Uuid
  userPreference   UserPreference @relation(fields: [userPreferenceId], references: [id], onDelete: Cascade)
  operationType    OperationType  @relation(fields: [operationTypeId], references: [id], onDelete: Cascade)

  @@unique([userPreferenceId, operationTypeId])
  @@map("user_preference_operation_types")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @db.VarChar(500)
  platform  String   @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamp(0)
  updatedAt DateTime @updatedAt @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}
